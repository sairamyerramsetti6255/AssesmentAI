# Consulting site is a single-page app. /assess has no file on disk.
# Apache must serve index.html so a refresh stays in the app.
Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave real files alone (JS, CSS, images).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Leave API calls alone if this host also proxies /api.
  RewriteRule ^api/ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# If rewrite is unavailable, still avoid a hard 404 on app routes.
ErrorDocument 404 /index.html
